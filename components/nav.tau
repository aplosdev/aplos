<header class="site-header">
  <a href="#content-main" class="skip-to-content">Skip to main content</a>
  {#if theme.nav?.show !== false}<nav class="site-nav" aria-label="Main navigation">
    <ul>
      <li class="site-title">
        <a href="/">{#if theme.nav?.title}{ theme.nav.title }{:else}{ site.title }{/if}</a>
      </li>
      {#each theme.nav?.links as link}
        <li><a href="{(link.url || link.link) | url}">{ link.title || link.text }</a></li>
      {/each}
      {#if theme.nav?.rss}
        <li>
          <a class="site-icon" target="_blank" rel="noopener noreferrer" href="{theme.nav.rss | url}" download aria-label="RSS feed">
            <span class="ph-icon ph-rss-simple" aria-hidden="true"></span>
          </a>
        </li>
      {/if}
      {#if theme.nav?.git}
        <li>
          <a class="site-icon" target="_blank" rel="noopener noreferrer" href="{theme.nav.git | url}" aria-label="Source code">
            <span class="ph-icon ph-code" aria-hidden="true"></span>
          </a>
        </li>
      {/if}
    </ul>
  </nav>{/if}
  {#if theme.nav?.show !== false && layout === 'article' && !theme.minimal}
    <div class="nav-pill nav-pill-reading" aria-hidden="true">
      <span class="reading-progress-ring" data-reading-progress></span>
      <span data-reading-time>&hellip;</span>
    </div>
  {/if}
  {#if theme.nav?.show !== false && layout !== 'articles' && layout !== 'notfound'}
    <button type="button" class="nav-pill nav-pill-toc" aria-label="Table of contents" aria-expanded="false" data-toc-toggle>
      <span class="ph-icon ph-list" aria-hidden="true"></span>
    </button>
  {/if}
</header>
